name: Android CI

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'

    # Устанавливаем Gradle 8.9 напрямую на сервер GitHub
    - name: Setup Gradle
      uses: gradle/actions/setup-gradle@v4
      with:
        gradle-version: '8.9'

    # Настраиваем Android SDK
    - name: Setup Android SDK
      uses: android-actions/setup-android@v3

    # Если файлы оказались во вложенной папке, переносим их в корень
    - name: Prepare Project Structure
      run: |
        if [ -d "NeonPlayer-Android" ]; then
          echo "Moving contents from NeonPlayer-Android to root..."
          cp -r NeonPlayer-Android/* . || true
        fi

    # Собираем APK напрямую через установленный Gradle
    - name: Build APK with Gradle
      run: gradle assembleDebug --stacktrace --no-daemon

    # Выгружаем готовый APK в Artifacts для скачивания
    - name: Upload Debug APK
      uses: actions/upload-artifact@v4
      with:
        name: NeonPlayer-APK
        path: |
          app/build/outputs/apk/debug/*.apk
          **/build/outputs/apk/debug/*.apk
